# PLAYX Backend Environment Variables Template for Railway
# Configure these variables in your Railway Project Service -> Variables tab.
# Do NOT commit sensitive passwords or real credentials into version control.

# Server Port (assigned dynamically by Railway)
PORT=5000

# Database Connection
# In Railway: Link MySQL service or set DATABASE_URL to ${{ MySQL.MYSQL_PRIVATE_URL }}
DATABASE_URL=
# Alternatively, Railway native MySQL variables (if not using DATABASE_URL):
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=

# Security & Authentication
JWT_SECRET=your_256_bit_secure_jwt_secret_key_here
JWT_EXPIRES_IN=604800000

# Frontend URL for CORS (Point to your Vercel deployment domain)
FRONTEND_URL=https://playx-music-streaming-git-master-boct.vercel.app
CORS_ALLOWED_ORIGINS=https://playx-music-streaming-git-master-boct.vercel.app,https://playx-music-streaming-beta.vercel.app,https://playx-music-streaming-git-main-boct.vercel.app,https://playx-music-streaming-pizgzm2p1-boct.vercel.app

# File Storage Paths (For permanent persistence, mount a Railway Volume to /app/uploads)
MUSIC_STORAGE_PATH=uploads/music
MUSIC_COVERS_PATH=uploads/covers
MAX_AUDIO_FILE_SIZE=50MB

