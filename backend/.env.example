# PLAYX Backend Environment Variables Template
# Provide these variables in your Railway or Cloud deployment dashboard

# Server Port (assigned dynamically by Railway/Render)
PORT=5000

# Database Connection (Provide either DATABASE_URL or individual MySQL parameters)
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Security & Authentication
JWT_SECRET=

# Frontend URL for CORS (Set to your Vercel deployment domain)
FRONTEND_URL=https://playx-music-streaming-git-master-boct.vercel.app
CORS_ALLOWED_ORIGINS=

# Optional Local Storage Paths
MUSIC_STORAGE_PATH=uploads/music
MUSIC_COVERS_PATH=uploads/covers
