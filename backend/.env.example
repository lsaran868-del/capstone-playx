# PLAYX Backend Environment Variables Template
# Configure these variables in Render / Railway / local environment.
# Do NOT commit sensitive passwords or real credentials into version control.

# Server Port (assigned dynamically by hosting provider, default 5000 / 8080)
PORT=5000

# Database Connection (Supabase PostgreSQL via Connection Pooler IPv4)
DATABASE_URL=postgresql://playx_app.xrhlsbsyrzvpznuspqvh:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Or individual variables:
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=playx_app.xrhlsbsyrzvpznuspqvh
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Security & Authentication
JWT_SECRET=your_256_bit_secure_jwt_secret_key_here
JWT_EXPIRES_IN=604800000

# Frontend URL for CORS (Point to your Vercel deployment domain)
FRONTEND_URL=https://playx-music-streaming-git-master-boct.vercel.app
CORS_ALLOWED_ORIGINS=https://playx-music-streaming-git-master-boct.vercel.app,https://playx-music-streaming-beta.vercel.app,https://playx-music-streaming-git-main-boct.vercel.app,https://playx-music-streaming-pizgzm2p1-boct.vercel.app

# File Storage Paths
MUSIC_STORAGE_PATH=uploads/music
MUSIC_COVERS_PATH=uploads/covers
MAX_AUDIO_FILE_SIZE=50MB
